<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Asset Form View Extension for Equipment Link -->
        <record id="account_asset_view_form_equipment" model="ir.ui.view">
            <field name="name">account.asset.form.equipment</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="equipment_id" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <!-- Asset Tree View Extension for Equipment Link -->
        <record id="account_asset_view_tree_equipment" model="ir.ui.view">
            <field name="name">account.asset.tree.equipment</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                    <field name="equipment_id"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>