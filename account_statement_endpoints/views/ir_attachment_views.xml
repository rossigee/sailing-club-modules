<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Attachment Form View Extension for Public Display -->
        <record id="ir_attachment_view_form_public" model="ir.ui.view">
            <field name="name">ir.attachment.form.public</field>
            <field name="model">ir.attachment</field>
            <field name="inherit_id" ref="base.view_attachment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='description']" position="after">
                    <field name="public_display" attrs="{'invisible': [('res_model', '!=', 'maintenance.equipment')]}"/>
                </xpath>
            </field>
        </record>

        <!-- Attachment Tree View Extension for Public Display -->
        <record id="ir_attachment_view_tree_public" model="ir.ui.view">
            <field name="name">ir.attachment.tree.public</field>
            <field name="model">ir.attachment</field>
            <field name="inherit_id" ref="base.view_attachment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='mimetype']" position="after">
                    <field name="public_display" widget="boolean_toggle" attrs="{'invisible': [('res_model', '!=', 'maintenance.equipment')]}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>