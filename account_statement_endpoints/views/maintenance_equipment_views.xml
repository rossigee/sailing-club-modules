<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Equipment Form View Extension -->
        <record id="maintenance_equipment_view_form_public" model="ir.ui.view">
            <field name="name">maintenance.equipment.form.public</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group name="public_display_group" string="Public Website Display">
                        <group>
                            <field name="public_display"/>
                            <field name="condition" attrs="{'invisible': [('public_display', '=', False)]}"/>
                            <field name="availability" attrs="{'invisible': [('public_display', '=', False)]}"/>
                            <field name="rental_rate" attrs="{'invisible': [('public_display', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="year" attrs="{'invisible': [('public_display', '=', False)]}"/>
                            <field name="manufacturer" attrs="{'invisible': [('public_display', '=', False)]}"/>
                            <field name="model_name" attrs="{'invisible': [('public_display', '=', False)]}"/>
                        </group>
                    </group>
                    <group name="public_content_group" string="Public Content" attrs="{'invisible': [('public_display', '=', False)]}">
                        <field name="public_description" placeholder="General description for public display"/>
                        <field name="specifications" placeholder="Technical specifications (JSON format or key:value pairs)"/>
                    </group>
                    <group name="multilingual_group" string="Multilingual Content" attrs="{'invisible': [('public_display', '=', False)]}">
                        <group string="English Content">
                            <field name="display_name_en" placeholder="Display name in English (optional)"/>
                            <field name="public_description_en" placeholder="Description in English"/>
                            <field name="specifications_en" placeholder="Technical specifications in English"/>
                        </group>
                        <group string="Thai Content">
                            <field name="display_name_th" placeholder="Display name in Thai (optional)"/>
                            <field name="public_description_th" placeholder="Description in Thai"/>
                            <field name="specifications_th" placeholder="Technical specifications in Thai"/>
                        </group>
                    </group>
                    <group name="asset_integration_group" string="Asset Integration" attrs="{'invisible': [('public_display', '=', False)]}">
                        <group>
                            <field name="purchase_value" readonly="1"/>
                            <field name="current_value" readonly="1"/>
                        </group>
                        <group>
                            <field name="asset_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <separator string="Public Images" attrs="{'invisible': [('public_display', '=', False)]}"/>
                    <field name="public_image_ids" attrs="{'invisible': [('public_display', '=', False)]}" context="{'default_res_model': 'maintenance.equipment', 'default_public_display': True}">
                        <tree string="Public Images">
                            <field name="name"/>
                            <field name="mimetype"/>
                            <field name="file_size"/>
                            <field name="public_display" widget="boolean_toggle"/>
                        </tree>
                        <form string="Public Image">
                            <group>
                                <field name="name"/>
                                <field name="datas" filename="name"/>
                                <field name="public_display"/>
                                <field name="description"/>
                            </group>
                        </form>
                    </field>
                </xpath>
            </field>
        </record>

        <!-- Equipment Tree View Extension -->
        <record id="maintenance_equipment_view_tree_public" model="ir.ui.view">
            <field name="name">maintenance.equipment.tree.public</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="public_display" widget="boolean_toggle"/>
                    <field name="condition"/>
                    <field name="availability"/>
                    <field name="rental_rate"/>
                </xpath>
            </field>
        </record>

        <!-- Equipment Search View Extension -->
        <record id="maintenance_equipment_view_search_public" model="ir.ui.view">
            <field name="name">maintenance.equipment.search.public</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter string="Public Display" name="filter_public_display" domain="[('public_display', '=', True)]"/>
                    <filter string="Available" name="filter_available" domain="[('availability', '=', 'available')]"/>
                    <filter string="Good Condition" name="filter_good_condition" domain="[('condition', 'in', ['excellent', 'good'])]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Public Display" name="group_public_display" context="{'group_by': 'public_display'}"/>
                        <filter string="Condition" name="group_condition" context="{'group_by': 'condition'}"/>
                        <filter string="Availability" name="group_availability" context="{'group_by': 'availability'}"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Menu Item for Public Equipment -->
        <record id="action_maintenance_equipment_public" model="ir.actions.act_window">
            <field name="name">Public Equipment</field>
            <field name="res_model">maintenance.equipment</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('public_display', '=', True)]</field>
            <field name="context">{'default_public_display': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first piece of public equipment!
                </p>
                <p>
                    Equipment marked for public display will appear on the sailing club website.
                    Include photos, specifications, and rental information to help visitors.
                </p>
            </field>
        </record>

        <!-- Equipment Kanban View for Public Display Management -->
        <record id="maintenance_equipment_view_kanban_public" model="ir.ui.view">
            <field name="name">maintenance.equipment.kanban.public</field>
            <field name="model">maintenance.equipment</field>
            <field name="arch" type="xml">
                <kanban default_group_by="category_id" class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="public_display"/>
                    <field name="condition"/>
                    <field name="availability"/>
                    <field name="rental_rate"/>
                    <field name="image_1920"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('maintenance.equipment', 'image_1920', record.id.raw_value)" alt="Equipment"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="category_id"/>
                                    </div>
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge badge-secondary" t-if="record.public_display.raw_value">Public</span>
                                        <span class="badge badge-success" t-if="record.condition.raw_value == 'excellent'">Excellent</span>
                                        <span class="badge badge-info" t-if="record.condition.raw_value == 'good'">Good</span>
                                        <span class="badge badge-warning" t-if="record.condition.raw_value == 'fair'">Fair</span>
                                        <span class="badge badge-danger" t-if="record.condition.raw_value == 'poor'">Poor</span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.rental_rate.raw_value">฿<t t-esc="record.rental_rate.value"/>/day</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Add Kanban view to action -->
        <record id="action_maintenance_equipment_public_kanban" model="ir.actions.act_window">
            <field name="name">Public Equipment (Kanban)</field>
            <field name="res_model">maintenance.equipment</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('public_display', '=', True)]</field>
            <field name="context">{'default_public_display': True}</field>
            <field name="view_id" ref="maintenance_equipment_view_kanban_public"/>
        </record>

    </data>
</odoo>