<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Digest Form View -->
    <record id="digest_digest_view_form_inherit_bksc" model="ir.ui.view">
        <field name="name">digest.digest.form.inherit.bksc</field>
        <field name="model">digest.digest</field>
        <field name="inherit_id" ref="digest.digest_digest_view_form"/>
        <field name="arch" type="xml">
            <!-- Add BKSC KPIs section -->
            <xpath expr="//group[@name='kpi_general']" position="after">
                <group name="kpi_bksc" string="BKSC Metrics">
                    <field name="kpi_bksc_bank_statements"/>
                    <field name="kpi_bksc_recent_transactions"/>
                    <field name="kpi_bksc_account_balance"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add menu item for easy access to digest configuration -->
    <menuitem id="menu_bksc_digest_config"
        name="BKSC Digest Configuration"
        parent="digest.digest_menu"
        action="digest.digest_digest_action"
        sequence="50"/>
</odoo>